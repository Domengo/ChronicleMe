{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "forwardPorts": [
    22,
    3000,
    3001,
    8081
  ],
  "portsAttributes": {
    "3000": {
      "protocol": "http",
      "label": "App Port 3000"
    },
    "3001": {
      "protocol": "http",
      "label": "App Port 3001"
    }
  }
}
